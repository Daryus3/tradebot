# =====================================================================
#  KRİPTO AL-SAT BOTU AYARLARI (strateji, risk, filtreler)
#  Bu dosya GitHub'da durur ve GİZLİ BİLGİ İÇERMEZ.
#
#  API anahtarı ve Telegram bilgileri bu dosyaya YAZILMAZ. Onlar sunucuda,
#  proje klasöründeki ".env" dosyasına yazılır (GitHub'a hiç yüklenmez):
#      BINANCE_API_KEY=        (yalnızca canlı mod için; test modunda boş kalır)
#      BINANCE_API_SECRET=
#      TELEGRAM_BOT_TOKEN=     (BotFather'dan)
#      TELEGRAM_CHAT_ID=       (bulmak için: python main.py --telegram-chat-id)
#  .env'ye buradaki bir ayarı da yazarsanız .env'deki değer geçerli olur.
#  Ayarı değiştirdikten sonra: sudo systemctl restart tradebot
# =====================================================================

# ---------------------------------------------------------------------
# Çalışma modu
#   paper = TEST: 11 USDT SANAL bakiye, canlı fiyatlar, gerçek emir YOK
#   live  = CANLI: gerçek bakiyenizle gerçek emir
# ---------------------------------------------------------------------
TRADING_MODE=paper

# ---------------------------------------------------------------------
# Sermaye ve risk
# ---------------------------------------------------------------------
# Botun yöneteceği sermaye (test modunda sanal bakiye)
START_CAPITAL_USDT=32
# Sermayenin yüzde kaçıyla işleme girilsin (100 = tamamı, küçük bakiyede önerilen).
# "Yedek akçe": örn. 50 yazılırsa her pozisyona ayrılan payın yarısıyla girilir, kalanı USDT olarak yedekte bekler
# (Telegram: /menu → Sermaye). Pozisyon Binance'in ~5 USDT minimumunun altına inecekse pozisyon sayısı azalır.
CAPITAL_USAGE_PCT=100
# Aynı anda en fazla kaç farklı coinde pozisyon açılsın (1-10).
# Bakiye yetmezse bot bunu OTOMATİK azaltır: her pozisyon, stop-loss'a düşse bile
# Binance'in ~5 USDT minimum emir tutarının üstünde kalmalı (pozisyon başı ≈5.83 USDT).
#   11 USDT → 1 pozisyon | ~12 USDT → 2 | ~17.5 USDT ve üstü → 3
# Her zaman tek pozisyon istiyorsanız 1 yapın.
MAX_OPEN_POSITIONS=1
# KILL-SWITCH: toplam zarar (gerçekleşen + açık pozisyonlar) botun sermayesinin bu YÜZDESİNE
# ulaşınca bot her şeyi satar ve kapanır. 45 → 11 USDT'de ≈4.95 USDT, 100 USDT'de 45 USDT.
# Hesaba para ekleyip Telegram'dan /sermayeekle ile bota tanıttığınızda limit de otomatik büyür.
# (Eski sabit MAX_TOTAL_LOSS_USDT ayarı yalnızca bu satır boşsa uygulanır; yüzdeye geçmek için onu silin.)
MAX_TOTAL_LOSS_PCT=40

# Kâr al: net (komisyon sonrası) kâr bu yüzdeye ulaşınca sat  → 11 USDT ≈ 12.65
TAKE_PROFIT_PCT=50
# Zarar kes: net zarar bu yüzdeye ulaşınca sat                  → 11 USDT ≈ 9.90
STOP_LOSS_PCT=10
# İzleyen stop: net kâr bir kez bu seviyeyi görürse...          → 11 USDT ≈ 12.10
TRAILING_ACTIVATION_PCT=2
# ...ve sonra bu seviyeye düşerse sat (kârın yarısı korunur)    → 11 USDT ≈ 11.55
TRAILING_FLOOR_PCT=1
# true: koruma seviyesi zirve kârın yarısıyla birlikte yükselir (örn. zirve %14 → %7'de sat)
TRAILING_DYNAMIC=true

# İşlem komisyonu. Binance standart spot: %0.1 = 0.001.
# Binance'te "BNB ile komisyon öde" açıksa ve Spot'ta BNB varsa %25 indirimli: 0.00075 yazın
# (ayrıntı aşağıda "BNB ile komisyon indirimi" bölümünde).
FEE_RATE=0.00075

# Pozisyonu en fazla kaç dakika tut (0 = sınırsız; sadece TP/SL/izleyen stop ile çıkılır)
MAX_HOLD_MINUTES=500
# Bir coinden çıktıktan sonra aynı coine tekrar girmeden önce beklenecek süre (dk)
SYMBOL_COOLDOWN_MINUTES=30
# LOT adımı yüzünden satışta kalan "toz" kaybı en fazla bu yüzde olabilir
MAX_DUST_PCT=0.5
# Stop-loss seviyesinde bile pozisyon, minimum emir tutarının bu katı olmalı
MIN_NOTIONAL_SAFETY=1.05

# ---------------------------------------------------------------------
# Zamanlama
# ---------------------------------------------------------------------
# Piyasa tarama aralığı (saniye)
SCAN_INTERVAL_SEC=30
# Açık pozisyonun fiyat kontrol aralığı (saniye) — kâr al/zarar kes hızı
POSITION_CHECK_SEC=1
# Telegram'a durum raporu aralığı (dakika, 0 = kapalı)
STATUS_REPORT_MINUTES=240

# ---------------------------------------------------------------------
# Strateji seçimi
# ---------------------------------------------------------------------
# rebound  = son 24 saatte DÜŞMÜŞ coinlerde dipten dönüşü alır (aşağıdaki ayarlar)
# trend    = son 24 saatte YÜKSELMİŞ, 5 dk EMA50 > EMA200 olan coinlerde fiyat EMA20'ye geri
#            çekilip tekrar yukarı dönünce alır
# breakout = yükselen trenddeki coinlerde son 4 saatin zirvesi yüksek hacimle kırılınca alır
# Hangisinin işe yaradığını önce backtest ile görün: python main.py --backtest --gun 90 --strateji-karsilastir
#
# UZUN VADELİ (1 saatlik mumlar, 1-5 gün tutulan, %8-15 hedefli işlemler):
# swing          = çok günlük yükseliş trendinde (1 saatlik EMA50 > EMA200) son 3 günün zirvesi yüksek
#                  hacimle kırılınca alır
# swing_pullback = aynı trendde fiyat zirveden %4-12 geri çekilip EMA50'ye inince ve yukarı dönünce alır
# Önce 1 yıllık veriyle deneyin: python main.py --backtest --strateji swing --strateji-karsilastir
# swing seçerseniz ÇIKIŞ AYARLARINI 1-5 günlük işlemlere göre yapın (5 dk stratejisi için bulunan TP %2-5,
# MAX_HOLD 60-240 dk, +%1 başabaş gibi değerler işlemi hareket başlamadan kapatır), örneğin:
#   TAKE_PROFIT_PCT=12  STOP_LOSS_PCT=6  TRAILING_ACTIVATION_PCT=8  TRAILING_FLOOR_PCT=4
#   MAX_HOLD_MINUTES=7200 (5 gün)  BREAKEVEN_TRIGGER_PCT=5  BREAKEVEN_FLOOR_PCT=1
#   MIN_SIGNAL_SCORE=0  MIN_ROOM_RATIO=0  MAX_24H_GAIN_PCT=25  (puan / alan eşikleri stratejiye özeldir)
# (Bot, swing ile kısa vadeli ayarları birlikte görürse açılışta uyarır.)
#
# HAFTALIK MOMENTUM ROTASYONU (günlük mumlar, coinler haftalarca tutulur):
# rotation = en hacimli coinler arasında son 4 haftanın en güçlü 3'ünü tutar, her hafta yeniden dengeler;
#            BTC 50 günlük ortalamasının altına inince her şeyi satıp USDT'de bekler.
#            Kâr al / izleyen stop / başabaş / maks. süre KULLANILMAZ; zarar kes yalnızca felaket korumasıdır:
#            STOP_LOSS_PCT=20  BACKUP_STOP_PCT=25 yapın.
# Önce 3 yıllık veriyle deneyin: python main.py --backtest --strateji rotation
#
# ORTALAMAYA DÖNÜŞ (1 saatlik mumlar, saatler-2 gün, küçük hedef → kazanma oranı yüksek):
# mean_revert = yalnızca en hacimli MR_UNIVERSE coinde; yükseliş trendindeki coinin saatlik kapanışı 20 saatlik
#               ortalamanın MR_BAND_STD standart sapma altına inince alır, ortalamaya dönüşte küçük kârla satar.
#               Önerilen çıkışlar: TAKE_PROFIT_PCT=1.5  STOP_LOSS_PCT=5  TRAILING_ACTIVATION_PCT=1
#               TRAILING_FLOOR_PCT=0.5  MAX_HOLD_MINUTES=2880  BREAKEVEN_TRIGGER_PCT=0.7  BREAKEVEN_FLOOR_PCT=0.2
# Hangi strateji + çıkış birleşiminin işe yaradığını tek komutla görün: python main.py --backtest --turnuva
STRATEGY=rebound
# trend / breakout: son 24 saatte en az / en fazla yüzde kaç YÜKSELMİŞ coinler taransın
# (MAX_24H_GAIN_PCT swing / swing_pullback için de üst sınırdır: daha fazla yükselmiş coin alınmaz)
MIN_24H_GAIN_PCT=2
MAX_24H_GAIN_PCT=12
# trend: zirveden geri çekilme en az / en fazla yüzde kaç olsun
TREND_PULLBACK_MIN_PCT=1
TREND_PULLBACK_MAX_PCT=5
# breakout: kaç mumluk zirve kırılsın (48 × 5 dk = 4 saat) ve kırılım mumunun hacmi ortalamanın en az kaç katı olsun
BREAKOUT_LOOKBACK_BARS=48
BREAKOUT_VOLUME_RATIO=2
# swing: kaç saatlik zirve kırılsın (72 = 3 gün; swing_pullback'te geri çekilmenin başladığı zirve penceresi)
SWING_LOOKBACK_HOURS=72
# swing: kırılım mumunun hacmi son 24 saatin ortalamasının en az kaç katı olsun
SWING_VOLUME_RATIO=1.5
# swing_pullback: zirveden geri çekilme en az / en fazla yüzde kaç olsun
SWING_PULLBACK_MIN_PCT=4
SWING_PULLBACK_MAX_PCT=12
# rotation: aynı anda kaç coin tutulsun (bakiye yetmezse otomatik azalır; MAX_OPEN_POSITIONS'tan fazla olamaz)
ROTATION_TOP_N=3
# rotation: momentum için son kaç günün getirisine bakılsın
ROTATION_LOOKBACK_DAYS=28
# rotation: kaç günde bir yeniden dengelensin (UTC 00:05'ten sonra, günlük mum kapanınca)
ROTATION_DAYS=7
# rotation: BTC bu günlük ortalamanın altına inince her şey satılıp USDT'de beklenir (0 = filtre kapalı)
ROTATION_BTC_MA_DAYS=50
# rotation: sıralamaya girecek en hacimli coin sayısı
ROTATION_UNIVERSE=30
# mean_revert: kapanış 20 saatlik ortalamanın kaç standart sapma altında olmalı (büyüdükçe daha az ama daha derin düşüş)
MR_BAND_STD=2
# mean_revert: yalnızca en hacimli bu kadar coin (büyük, likit coinler)
MR_UNIVERSE=20

# ---------------------------------------------------------------------
# Strateji ayrıntıları (rebound ayarları + tüm stratejiler için ortak filtreler)
# — emin değilseniz değiştirmeyin
# ---------------------------------------------------------------------
# Minimum 24 saatlik işlem hacmi (USDT) — likidite için
MIN_QUOTE_VOLUME_24H=3000000
# 24 saatte en az / en fazla yüzde kaç düşmüş coinler taransın
MIN_24H_DROP_PCT=2
MAX_24H_DROP_PCT=30
# 24 saatlik fiyat aralığı en az yüzde kaç olsun (oynaklık; swing stratejilerinde uygulanmaz)
MIN_24H_RANGE_PCT=4
# Her taramada ayrıntılı incelenecek en fazla aday sayısı (swing stratejileri bunun 3 katını inceler)
MAX_CANDIDATES=30
# Mum aralığı (yalnızca 5 dk stratejileri; swing stratejileri her zaman 1 saatlik mum kullanır)
KLINE_INTERVAL=5m
# Son 3 saatteki zirveden dibe en az yüzde kaç düşüş olsun
MIN_DIP_PCT=2.5
# Düşüşün en az / en fazla ne kadarı geri alınmış olsun (0.15 = %15, 0.60 = %60)
MIN_RETRACE=0.15
MAX_RETRACE=0.60
# RSI ayarları: dipte en fazla RSI_OVERSOLD görülmüş, şimdi ENTRY_MIN-ENTRY_MAX arasında ve yükseliyor
RSI_PERIOD=20
RSI_OVERSOLD=40
RSI_ENTRY_MIN=40
RSI_ENTRY_MAX=55
# Son 3 mumun hacmi, önceki 20 mumun ortalamasının en az kaç katı olsun
MIN_VOLUME_RATIO=1.0
# BTC son 1 saatte bu yüzdeden fazla düştüyse alım yapma
BTC_FILTER=true
BTC_MAX_1H_DROP_PCT=1.5
# Taramadan çıkarılacak ek coinler (virgülle), örn: PEPE,SHIB
EXCLUDED_ASSETS=

# ---------------------------------------------------------------------
# 🧷 Binance'te yedek zarar-kes emri
# Her alımdan sonra Binance'e bekleyen bir stop emri bırakılır. Bilgisayar kapalı/uykuda veya
# internet yokken bile pozisyon korunur. Bot normalde STOP_LOSS_PCT'de (-%10) kendisi satar;
# yedek emir biraz daha aşağıda bekler ve sadece bot ulaşılamazsa çalışır.
# ---------------------------------------------------------------------
BACKUP_STOP_ENABLED=true
BACKUP_STOP_PCT=12
# Paritede piyasa tipi stop yoksa limitli stop kullanılır; limit fiyat stop'un bu kadar altında
BACKUP_STOP_LIMIT_GAP_PCT=1

# ---------------------------------------------------------------------
# Ek çıkış kuralları
# ---------------------------------------------------------------------
# 🔒 Başabaş (varsayılan AÇIK): net kâr bir kez BREAKEVEN_TRIGGER_PCT'yi görürse, zarara dönmeden
# ~BREAKEVEN_FLOOR_PCT'de sat. TRIGGER, TRAILING_ACTIVATION_PCT'den küçük olmalı; yoksa izleyen stop
# zaten daha önce devreye girer ve başabaşın etkisi olmaz (örn. izleyen stop +%2 ise TRIGGER=1).
# 📉 BTC çöküşü (varsayılan KAPALI) aşağıda.
BREAKEVEN_ENABLED=true
BREAKEVEN_TRIGGER_PCT=1
BREAKEVEN_FLOOR_PCT=0.5
# 📉 BTC çöküşü: BTC son X dakikadaki zirvesinden Y% düşerse açık pozisyonları erken sat
BTC_CRASH_EXIT=false
BTC_CRASH_DROP_PCT=2
BTC_CRASH_WINDOW_MIN=15

# ---------------------------------------------------------------------
# ⚡ Anlık fiyat akışı (WebSocket) — açık pozisyon ~1 sn'de bir kontrol edilir
# ---------------------------------------------------------------------
USE_WEBSOCKET=true
WS_POSITION_CHECK_SEC=1

# ---------------------------------------------------------------------
# 📱 Telegram komutları ve raporlar
# ---------------------------------------------------------------------
# /durum /pozisyon /sat /durdur gibi komutlar (yalnızca TELEGRAM_CHAT_ID'den kabul edilir)
TELEGRAM_COMMANDS=true
# Doluysa /sat, /hepsinisat, /kapat, strateji değişikliği ve yeniden başlatma onayı "/evet PIN" ister
# (örn. 4 haneli bir sayı; PIN varken onay düğmesi gösterilmez, PIN yazılır)
COMMAND_PIN=
# Bakiyeyi Türk lirası karşılığıyla da göster (bilgi amaçlı)
SHOW_TRY=true
# Günlük özet saati (boş = kapalı). Bilgisayar o saatte kapalıysa sonraki açılışta gönderilir.
DAILY_REPORT_TIME=23:55
# Pazar günleri haftalık özet
WEEKLY_REPORT=true
# 🌙 Sessiz saatler: bu aralıkta rutin mesajlar bildirim sesi olmadan gelir
# (zarar kes, kill-switch ve kritik hatalar her zaman sesli). Örn: 23:00-08:00 — boş = kapalı
QUIET_HOURS=

# ---------------------------------------------------------------------
# 🎯 Alım filtreleri
# ---------------------------------------------------------------------
# Alış-satış fiyat farkı (spread) bu yüzdeden büyükse alma
MAX_SPREAD_PCT=0.3
# Alış fiyatı beklenenden bu kadar sapınca Telegram'a uyarı
SLIPPAGE_WARN_PCT=0.5
# Tehlikeli coin filtresi: delist takvimi, yeni listelenen, pompa sonrası sönen coinler
DELIST_FILTER=true
MIN_LISTING_DAYS=14
PUMP_FILTER_PCT=50
PUMP_LOOKBACK_DAYS=3
# Sinyal puanı alt sınırı (0 = kapalı). Uygun değeri işlem kaydındaki sinyal_puani sütunundan bulabilirsiniz.
MIN_SIGNAL_SCORE=0
# Hedef alanı filtresi (0 = kapalı). Düşüş öncesi zirveye kadar kalan fiyat alanı, Kâr Al için gereken
# hareketin en az bu katı olmalı. 1 → "fiyat eski zirvesine dönerse hedef görülebilir" olan sinyaller alınır.
# Etkisini önce backtest ile görün: python main.py --backtest --gun 90 --tara
MIN_ROOM_RATIO=0
# Sinyalin art arda kaç taramada görülmesi gerektiği (1 = kapalı, 2 = ~30 sn teyit)
SIGNAL_CONFIRM_SCANS=1
# Oynaklık filtresi: 5 dk ATR / fiyat (%) bu aralıkta olmalı
# (swing stratejilerinde 1 saatlik muma √12 ≈ 3.5 ile ölçeklenir: 0.25 → %0.87, 4 → %13.9)
MIN_ATR_PCT=0.25
MAX_ATR_PCT=4
# 🌡️ Piyasa rejimi: genel çöküşte alım durur, zayıf piyasada kurallar sıkılaşır ve en fazla 1 pozisyon açılır
REGIME_FILTER=true
# true: piyasa ZAYIF iken (BTC trendin altında / coinlerin çoğu düşüşte) hiç alım yapma (REGIME_FILTER=true gerekir).
# false (varsayılan): zayıf piyasada kurallar sıkılaşır ve en fazla 1 pozisyon açılır.
REGIME_SKIP_WEAK=false

# ---------------------------------------------------------------------
# 🪙 BNB ile komisyon indirimi (isteğe bağlı)
# Komisyonu BNB ile öderseniz %25 indirim alırsınız (%0.1 → %0.075). Açmak için Binance'te (uygulama
# veya web) Kontrol Paneli / Ücret Oranı sayfasındaki "BNB ile komisyon öde" (Pay fees with BNB /
# BNB Deduction) anahtarını açın ve Spot cüzdanınızda biraz BNB tutun. Bu durumda FEE_RATE=0.00075 yapın.
# BNB biterse Binance hiçbir uyarı vermeden komisyonu yine %0.1 olarak alınan coinden/USDT'den keser.
# Bot bu Binance ayarını DEĞİŞTİRMEZ ve OTOMATİK BNB ALMAZ; yalnızca açılışta ve saatte bir kontrol edip uyarır:
#   - gerçek komisyon FEE_RATE'ten farklıysa (örn. BNB bitti → net kâr al / zarar kes hesabı fazla iyimser),
#   - BNB bakiyesi BNB_MIN_TRADES al-sat işleminden azına yetecek kadar kaldıysa (sessiz bilgi, günde en fazla bir).
# Neden otomatik BNB almıyor? Binance'te en küçük emir ~5 USDT: 11 USDT'lik hesapta bu, paranın yarısına
# yakınını oynak bir coine bağlamak demek. Kazanç ise taraf başına yalnızca %0.025
# (11 USDT'lik bir al-satta toplam ≈0.0055 USDT). BNB'yi isterseniz kendiniz, az miktarda alın.
# BNB'yi botun sermayesinden değil ayrı bir parayla alın. İndirim açıkken bot BNBUSDT'de işlem açmaz.
# ---------------------------------------------------------------------
# false = BNB bakiyesi bildirimleri kapalı (yanlış FEE_RATE uyarısı ve BNBUSDT'nin işlem dışı kalması sürer)
BNB_FEE_CHECK=true
# BNB bakiyesi bu kadar al-sat işleminden azına yetecekse sessiz bilgi ver (0 = bu bildirim kapalı)
BNB_MIN_TRADES=10

# ---------------------------------------------------------------------
# 🎛️ Telegram kontrol paneli (/menu)
# Aşağıdaki ayarların çoğu Telegram'dan /menu (düğmeler) veya /ayar ANAHTAR DEĞER ile değiştirilebilir.
# Menüden yapılan değişiklik hemen uygulanır ve sunucudaki .env dosyasının SONUNA yazılır; .env buradaki
# değeri ezer. Bir ayarı tekrar buradan yönetmek isterseniz .env'deki o satırı silin.
# ---------------------------------------------------------------------
# Bildirim modu: all = hepsi | closes = yalnızca pozisyon kapanışları | silent = yalnızca acil durumlar
# (komut cevapları, uyarılar ve zarar kes / kill-switch gibi kritik mesajlar her modda gelir)
NOTIFY_MODE=all
# Menüdeki "Sunucu Reset" düğmesinin yeniden başlattığı servis (VPS_KURULUM.md → Telegram'dan yeniden başlatma)
SERVICE_NAME=tradebot.service
# Sunucunun dış IP adresi bu kadar dakikada bir kontrol edilir; değişirse Telegram'a alarm gelir (0 = kapalı).
# Binance API anahtarında IP kısıtlaması varsa IP değişince emirler -2015 hatası alır.
IP_CHECK_MINUTES=10

# ---------------------------------------------------------------------
# 🛡️ Ek giriş filtreleri (hepsi varsayılan KAPALI; /menu → Filtreler'den açılıp kapatılabilir)
# Her filtre işlem sayısını azaltır. Hangisinin kârı artırdığını önce görün:
#   python main.py --backtest --gun 90 --tara-ab
# ---------------------------------------------------------------------
# Spread kalkanı: false yapılırsa MAX_SPREAD_PCT kontrolü yapılmaz (önerilmez)
SPREAD_FILTER=true
# Sahte yükseliş: son kapanmış mumun üst fitili gövdesinden uzunsa (satıcılar yükselişi geri itti) alma
FAKEOUT_FILTER=false
# VWAP: fiyat son VWAP_BARS mumun hacim ağırlıklı ortalama fiyatının (VWAP) altındaysa alma
# (Not: rebound düşen coinde dip alır; fiyat çoğu zaman VWAP altındadır, bu filtre alımların çoğunu engelleyebilir)
VWAP_FILTER=false
VWAP_BARS=48
# Aşırı ısınma: son OVERHEAT_MINUTES dakikanın en düşüğünden OVERHEAT_PCT'den fazla yükselmiş coini alma
OVERHEAT_FILTER=false
OVERHEAT_PCT=10
OVERHEAT_MINUTES=60
# Aşağıdakiler yalnızca canlı veriyle çalışır (geçmiş emir defteri olmadığı için backtest edilemez):
# Satış duvarı radarı: alış fiyatının +OB_BAND_PCT üstüne kadar tek bir fiyat seviyesinde, defterdeki ortanca
# seviyenin OB_WALL_RATIO katından büyük satış emri ("duvar") varsa alma
OB_WALL_FILTER=false
OB_BAND_PCT=1
OB_WALL_RATIO=10
# Emir defteri dengesizliği: ±OB_BAND_PCT bandındaki satış emirleri alış emirlerinin bu katıysa alma
OB_IMBALANCE_FILTER=false
OB_IMBALANCE_RATIO=5
# Tape okuma teyidi: son TAPE_SECONDS saniyedeki işlemlerde piyasa alımlarının payı bundan düşükse alma
TAPE_FILTER=false
TAPE_SECONDS=60
TAPE_MIN_BUY_RATIO=0.55

# ---------------------------------------------------------------------
# 🧯 Risk sigortaları (yalnızca YENİ alımları geçici durdurur; açık pozisyonların takibi sürer)
# ---------------------------------------------------------------------
# Günlük net zarar sermayenin bu yüzdesine ulaşınca gün sonuna (gece yarısı) kadar alım yok (0 = kapalı)
DAILY_LOSS_LIMIT_PCT=0
# Günlük net kâr bu yüzdeye ulaşınca gün sonuna kadar alım yok: kâr korunur (0 = kapalı)
DAILY_PROFIT_TARGET_PCT=0
# Üst üste bu kadar zarar kes olursa LOSS_STREAK_PAUSE_HOURS saat alım yok (0 = kapalı)
LOSS_STREAK_LIMIT=3
LOSS_STREAK_PAUSE_HOURS=4
# Coin karnesi: aynı coinde üst üste bu kadar zarar kes olursa Telegram'da "24 saat kara listeye alınsın mı?"
# diye sorulur (0 = kapalı)
COIN_SL_LIMIT=3
# Kayma alarmı: son 10 alımın ortalama kayması (beklenen fiyattan pahalı alış) bu yüzdeyi aşarsa uyar (0 = kapalı)
SLIPPAGE_ALERT_PCT=0.3

# ---------------------------------------------------------------------
# 🧠 Akıllı pozisyon yönetimi (hepsi varsayılan KAPALI; /menu → Akıllı Yönetim'den açılıp kapatılabilir)
# Modlar: off = kapalı | ask = Telegram'dan düğmeyle sorar | auto = sormadan uygular.
# "auto" hallerinin geçmiş veriyle etkisi: python main.py --backtest --gun 90 --tara-ab
# ---------------------------------------------------------------------
# ATR hedefleri: Kâr Al = coinin 1 saatlik ATR'si × ATR_TP_MULT, Zarar Kes = ATR × ATR_SL_MULT.
# Zarar Kes yalnızca DARALIR (en fazla STOP_LOSS_PCT); Kâr Al ATR_TP_MIN_PCT…ATR_TP_MAX_PCT arasında kalır.
ATR_TARGETS=false
ATR_TP_MULT=3
ATR_SL_MULT=2
ATR_TP_MIN_PCT=1
ATR_TP_MAX_PCT=15
ATR_SL_MIN_PCT=1
# Hedef uzatma: Kâr Al'a gelindiğinde momentum güçlüyse (yeşil mum, EMA9 üstü, artan hacim) satma;
# zirveden TP_EXTEND_GAP_PCT geri dönünce sat
TP_EXTEND=false
TP_EXTEND_GAP_PCT=0.5
# DCA (ortalama düşürme): net zarar DCA_TRIGGER_PCT'ye inince pozisyonun yedek akçesiyle bir kez ekle.
# Yedek akçe için CAPITAL_USAGE_PCT 100'den küçük olmalı (örn. 50). Ekledikten sonra zarar kes yeni ortalamaya
# göre hesaplanır: pozisyon büyüdüğü için olası zarar da büyür.
DCA_MODE=off
DCA_TRIGGER_PCT=5
# Piramit: net kâr PYRAMID_TRIGGER_PCT'ye çıkıp momentum güçlüyse yedek akçeyle bir kez ekle; sonra birleşik
# pozisyon zarara dönmeden (BREAKEVEN_FLOOR_PCT kadar kârla) satılır
PYRAMID_MODE=off
PYRAMID_TRIGGER_PCT=3
# Süre sorusu: pozisyon TIME_EXIT_MINUTES dakikadır ±TIME_EXIT_BAND_PCT içinde yataysa "başabaşta satılsın mı?"
# (MAX_HOLD_MINUTES kuralı ayrıca geçerli)
TIME_EXIT_MODE=off
TIME_EXIT_MINUTES=180
TIME_EXIT_BAND_PCT=0.5
# Erken kaçış: net zarar ESCAPE_TRIGGER_PCT'ye inmiş ve son mum ortalamanın ESCAPE_VOLUME_RATIO katı hacimle
# satıcı ağırlıklı kırmızı kapanmışsa zarar kesi beklemeden çık
ESCAPE_MODE=off
ESCAPE_TRIGGER_PCT=4
ESCAPE_VOLUME_RATIO=1.5

# ---------------------------------------------------------------------
# 🪜 Akıllı giriş ve bildirimler
# ---------------------------------------------------------------------
# Kademeli alım (trailing buy): sinyalden sonra hemen alma; fiyat düştükçe bekle, dipten TRAILING_BUY_PCT
# dönünce al. TRAILING_BUY_MINUTES içinde dönüş olmazsa sinyal iptal.
TRAILING_BUY=false
TRAILING_BUY_PCT=0.3
TRAILING_BUY_MINUTES=15
# Sinyal onayı: off | volatile (1 saatlik ATR APPROVAL_ATR_PCT'yi aşıyorsa ya da son 5 dk'da coinde
# APPROVAL_LIQ_USDT long likidasyonu varsa sor) | all (her sinyalde sor). Onay APPROVAL_TIMEOUT_SEC içinde gelmezse
# alınmaz; reddedilen coin bir süre tekrar sorulmaz.
SIGNAL_APPROVAL=off
APPROVAL_ATR_PCT=3
APPROVAL_LIQ_USDT=100000
APPROVAL_TIMEOUT_SEC=120
# Binance vadeli işlemler likidasyon akışı (herkese açık WebSocket). LIQ_ALERT_USDT > 0 ise bir coinde 5 dk'da bu
# kadar long likidasyonu olunca bilgi mesajı gelir.
LIQ_FEED=false
LIQ_ALERT_USDT=0
# En hacimli 40 coinde 1 saatlik pozitif RSI uyumsuzluğu (fiyat daha düşük dip, RSI daha yüksek dip) bildirimi
RSI_DIV_ALERTS=false
RSI_DIV_SCAN_MINUTES=60
# /pano: tek mesaj PNL_BOARD_SEC saniyede bir güncellenir, PNL_BOARD_MINUTES sonra durur
PNL_BOARD_SEC=5
PNL_BOARD_MINUTES=30
# BNB azalınca "şu kadar USDT'lik BNB alınsın mı?" diye sorar (canlı mod; 0 = sorma). Binance'in en küçük emri
# ~5 USDT olduğu için daha küçük alım yapılamaz. Tutar botun sermayesinden değil, bota ayrılmamış bakiyeden ödenir.
BNB_TOPUP_USDT=6

# ---------------------------------------------------------------------
# 🔧 Güvenilirlik
# ---------------------------------------------------------------------
# Bot bu kadar saniye çalışmazsa (sunucu / bilgisayar takıldıysa) Telegram'a uyarı
OUTAGE_ALERT_SEC=120
# Açılışta internet yoksa kapanmak yerine bekle
WAIT_FOR_NETWORK=true
# İnternet kesikken biriktirilecek en fazla Telegram mesajı
TELEGRAM_QUEUE_MAX=300
# Bakiye seyri kaydı (data/equity_<mod>.csv) aralığı, dakika (0 = kapalı)
EQUITY_LOG_MINUTES=15

# ---------------------------------------------------------------------
# Gelişmiş
# ---------------------------------------------------------------------
LOG_LEVEL=INFO
BINANCE_BASE_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443/ws
