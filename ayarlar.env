# =====================================================================
#  KRİPTO AL-SAT BOTU AYARLARI (strateji, risk, filtreler)
#  Bu dosya GitHub'da durur ve GİZLİ BİLGİ İÇERMEZ.
#
#  API anahtarı ve Telegram bilgileri bu dosyaya YAZILMAZ. Onlar sunucuda,
#  proje klasöründeki ".env" dosyasına yazılır (GitHub'a hiç yüklenmez):
#      BINANCE_API_KEY=        (yalnızca canlı mod için; test modunda boş kalır)
#      BINANCE_API_SECRET=
#      TELEGRAM_BOT_TOKEN=     (BotFather'dan)
#      TELEGRAM_CHAT_ID=       (bulmak için: python main.py --telegram-chat-id)
#  .env'ye buradaki bir ayarı da yazarsanız .env'deki değer geçerli olur.
#  Ayarı değiştirdikten sonra: sudo systemctl restart tradebot
# =====================================================================

# ---------------------------------------------------------------------
# Çalışma modu
#   paper = TEST: 11 USDT SANAL bakiye, canlı fiyatlar, gerçek emir YOK
#   live  = CANLI: gerçek bakiyenizle gerçek emir
# ---------------------------------------------------------------------
TRADING_MODE=paper

# ---------------------------------------------------------------------
# Sermaye ve risk
# ---------------------------------------------------------------------
# Botun yöneteceği sermaye (test modunda sanal bakiye)
START_CAPITAL_USDT=32
# Sermayenin yüzde kaçıyla işleme girilsin (100 = tamamı, küçük bakiyede önerilen).
# "Yedek akçe": örn. 50 yazılırsa her pozisyona ayrılan payın yarısıyla girilir, kalanı USDT olarak yedekte bekler
# (Telegram: /menu → Sermaye). Pozisyon Binance'in ~5 USDT minimumunun altına inecekse pozisyon sayısı azalır.
CAPITAL_USAGE_PCT=100
# Aynı anda en fazla kaç farklı coinde pozisyon açılsın (1-10).
# Bakiye yetmezse bot bunu OTOMATİK azaltır: her pozisyon, stop-loss'a düşse bile
# Binance'in ~5 USDT minimum emir tutarının üstünde kalmalı (pozisyon başı ≈5.83 USDT).
#   11 USDT → 1 pozisyon | ~12 USDT → 2 | ~17.5 USDT ve üstü → 3
# Her zaman tek pozisyon istiyorsanız 1 yapın.
MAX_OPEN_POSITIONS=1
# KILL-SWITCH: toplam zarar (gerçekleşen + açık pozisyonlar) botun sermayesinin bu YÜZDESİNE
# ulaşınca bot her şeyi satar ve kapanır. 45 → 11 USDT'de ≈4.95 USDT, 100 USDT'de 45 USDT.
# Hesaba para ekleyip Telegram'dan /sermayeekle ile bota tanıttığınızda limit de otomatik büyür.
# Telegram: /menu → 🧯 Risk / Kill-switch → ☠️ (sıkılaştırmak hemen, gevşetmek onayla; .env'ye yazılır).
# (Eski sabit MAX_TOTAL_LOSS_USDT ayarı yalnızca bu satır boşsa uygulanır; yüzdeye geçmek için onu silin.)
MAX_TOTAL_LOSS_PCT=40

# Kâr al: net (komisyon sonrası) kâr bu yüzdeye ulaşınca sat  → 11 USDT ≈ 12.65
TAKE_PROFIT_PCT=50
# Zarar kes: net zarar bu yüzdeye ulaşınca sat                  → 11 USDT ≈ 9.90
STOP_LOSS_PCT=10
# İzleyen stop: net kâr bir kez bu seviyeyi görürse...          → 11 USDT ≈ 12.10
TRAILING_ACTIVATION_PCT=2
# ...ve sonra bu seviyeye düşerse sat (kârın yarısı korunur)    → 11 USDT ≈ 11.55
TRAILING_FLOOR_PCT=1
# true: koruma seviyesi zirve kârın yarısıyla birlikte yükselir (örn. zirve %14 → %7'de sat)
TRAILING_DYNAMIC=true

# İşlem komisyonu. Binance standart spot: %0.1 = 0.001.
# Binance'te "BNB ile komisyon öde" açıksa ve Spot'ta BNB varsa %25 indirimli: 0.00075 yazın
# (ayrıntı aşağıda "BNB ile komisyon indirimi" bölümünde).
FEE_RATE=0.00075

# Pozisyonu en fazla kaç dakika tut (0 = sınırsız; sadece TP/SL/izleyen stop ile çıkılır)
MAX_HOLD_MINUTES=500
# Bir coinden çıktıktan sonra aynı coine tekrar girmeden önce beklenecek süre (dk)
SYMBOL_COOLDOWN_MINUTES=30
# LOT adımı yüzünden satışta kalan "toz" kaybı en fazla bu yüzde olabilir
MAX_DUST_PCT=0.5
# Stop-loss seviyesinde bile pozisyon, minimum emir tutarının bu katı olmalı
MIN_NOTIONAL_SAFETY=1.05

# ---------------------------------------------------------------------
# Zamanlama
# ---------------------------------------------------------------------
# Piyasa tarama aralığı (saniye)
SCAN_INTERVAL_SEC=30
# Açık pozisyonun fiyat kontrol aralığı (saniye) — kâr al/zarar kes hızı
POSITION_CHECK_SEC=1
# Telegram'a durum raporu aralığı (dakika, 0 = kapalı)
STATUS_REPORT_MINUTES=240

# ---------------------------------------------------------------------
# Strateji seçimi
# ---------------------------------------------------------------------
# rebound  = son 24 saatte DÜŞMÜŞ coinlerde dipten dönüşü alır (aşağıdaki ayarlar)
# trend    = son 24 saatte YÜKSELMİŞ, 5 dk EMA50 > EMA200 olan coinlerde fiyat EMA20'ye geri
#            çekilip tekrar yukarı dönünce alır
# breakout = yükselen trenddeki coinlerde son 4 saatin zirvesi yüksek hacimle kırılınca alır
# Hangisinin işe yaradığını önce backtest ile görün: python main.py --backtest --gun 90 --strateji-karsilastir
#
# UZUN VADELİ (1 saatlik mumlar, 1-5 gün tutulan, %8-15 hedefli işlemler):
# swing          = çok günlük yükseliş trendinde (1 saatlik EMA50 > EMA200) son 3 günün zirvesi yüksek
#                  hacimle kırılınca alır
# swing_pullback = aynı trendde fiyat zirveden %4-12 geri çekilip EMA50'ye inince ve yukarı dönünce alır
# Önce 1 yıllık veriyle deneyin: python main.py --backtest --strateji swing --strateji-karsilastir
# swing seçerseniz ÇIKIŞ AYARLARINI 1-5 günlük işlemlere göre yapın (5 dk stratejisi için bulunan TP %2-5,
# MAX_HOLD 60-240 dk, +%1 başabaş gibi değerler işlemi hareket başlamadan kapatır), örneğin:
#   TAKE_PROFIT_PCT=12  STOP_LOSS_PCT=6  TRAILING_ACTIVATION_PCT=8  TRAILING_FLOOR_PCT=4
#   MAX_HOLD_MINUTES=7200 (5 gün)  BREAKEVEN_TRIGGER_PCT=5  BREAKEVEN_FLOOR_PCT=1
#   MIN_SIGNAL_SCORE=0  MIN_ROOM_RATIO=0  MAX_24H_GAIN_PCT=25  (puan / alan eşikleri stratejiye özeldir)
# (Bot, swing ile kısa vadeli ayarları birlikte görürse bot.log'a uyarı yazar.)
#
# HAFTALIK MOMENTUM ROTASYONU (günlük mumlar, coinler haftalarca tutulur):
# rotation = en hacimli coinler arasında son 4 haftanın en güçlü 3'ünü tutar, her hafta yeniden dengeler;
#            BTC 50 günlük ortalamasının altına inince her şeyi satıp USDT'de bekler.
#            Kâr al / izleyen stop / başabaş / maks. süre KULLANILMAZ; zarar kes yalnızca felaket korumasıdır:
#            STOP_LOSS_PCT=20  BACKUP_STOP_PCT=25 yapın.
# Önce 3 yıllık veriyle deneyin: python main.py --backtest --strateji rotation
#
# ORTALAMAYA DÖNÜŞ (1 saatlik mumlar, saatler-2 gün, küçük hedef → kazanma oranı yüksek):
# mean_revert = yalnızca en hacimli MR_UNIVERSE coinde; yükseliş trendindeki coinin saatlik kapanışı 20 saatlik
#               ortalamanın MR_BAND_STD standart sapma altına inince alır, ortalamaya dönüşte küçük kârla satar.
#               Önerilen çıkışlar: TAKE_PROFIT_PCT=1.5  STOP_LOSS_PCT=5  TRAILING_ACTIVATION_PCT=1
#               TRAILING_FLOOR_PCT=0.5  MAX_HOLD_MINUTES=2880  BREAKEVEN_TRIGGER_PCT=0.7  BREAKEVEN_FLOOR_PCT=0.2
# rsi_divergence = aynı çıkış grubu; en hacimli RSI_DIV_UNIVERSE coinde pozitif RSI uyumsuzluğu (fiyat daha düşük dip,
#               RSI daha yüksek dip) görülüp son saatlik mum dönüşü teyit edince (yeşil, dipten beri görülen en yüksek
#               seviyenin üstünde, ortalamanın üstünde hacimle) alır. Deneyin: python main.py --backtest --strateji rsi_divergence
# Hangi strateji + çıkış birleşiminin işe yaradığını tek komutla görün: python main.py --backtest --turnuva
#
# GÜN İÇİ AL-SAT, YALNIZCA EN BÜYÜK COINLER (5 dk mumlar, saatler içinde kapanan küçük hedefli işlemler):
# intraday = yalnızca INTRADAY_COINS listesindeki coinlerde, INTRADAY_TACTIC taktiğiyle alır (aşağıda).
#            Önerilen çıkışlar (Telegram'dan strateji seçilince otomatik yüklenir): TAKE_PROFIT_PCT=1.2
#            STOP_LOSS_PCT=2.5  TRAILING_ACTIVATION_PCT=1  TRAILING_FLOOR_PCT=0.5  MAX_HOLD_MINUTES=360
#            BREAKEVEN_TRIGGER_PCT=0.6  BREAKEVEN_FLOOR_PCT=0.1. VWAP altından alan taktiklerde VWAP_FILTER=false yapın.
#            Taktikleri karşılaştırın: python main.py --backtest --strateji intraday --gun 365 --strateji-karsilastir
#            UYARI: 9 yıllık testte (2017-2026) hiçbir taktik kâr etmedi (en iyisi vwap + trend filtresi: -%28);
#            işlem başı maliyet (~%0.2) taktiklerin avantajından büyük. Gerçek parayla kullanmayın.
#
# VADELİ İŞLEM (Binance USDⓈ-M, kaldıraçlı, 5 dk mumlar; ayrıntılar aşağıda FUTURES_*):
# futures = FUTURES_TACTIC=crash (varsayılan, çöküş dönüşü): son 4 saatte en az %10 düşen coinde (likidasyon şelalesi)
#           5 dk mum kapanışında long. Telegram'dan strateji seçilince çıkışlar otomatik yüklenir (FİYAT yüzdesi):
#           TAKE_PROFIT_PCT=6  STOP_LOSS_PCT=4  BREAKEVEN_TRIGGER_PCT=1.5  BREAKEVEN_FLOOR_PCT=0.3  MAX_HOLD_MINUTES=30
#           LOSS_COOLDOWN_MINUTES=240. Kaldıraç 2x (en fazla 3x önerilir: 10x'te Mart 2020'de hesap eridi).
#           Vadeli cüzdan, durum ve işlem kaydı spot'tan ayrıdır (data/state_futures_*.json, trades_futures_*.csv).
#           Deneyin: python main.py --backtest --strateji futures --tum-donem
#           FUTURES_TACTIC=liq4 = ilk 4'lü onay sürümü (2020-2026'da 7 yılın 7'sinde zarar etti; karşılaştırma için).
STRATEGY=rebound
# trend / breakout: son 24 saatte en az / en fazla yüzde kaç YÜKSELMİŞ coinler taransın
# (MAX_24H_GAIN_PCT swing / swing_pullback için de üst sınırdır: daha fazla yükselmiş coin alınmaz)
MIN_24H_GAIN_PCT=2
MAX_24H_GAIN_PCT=12
# trend: zirveden geri çekilme en az / en fazla yüzde kaç olsun
TREND_PULLBACK_MIN_PCT=1
TREND_PULLBACK_MAX_PCT=5
# breakout: kaç mumluk zirve kırılsın (48 × 5 dk = 4 saat) ve kırılım mumunun hacmi ortalamanın en az kaç katı olsun
BREAKOUT_LOOKBACK_BARS=48
BREAKOUT_VOLUME_RATIO=2
# swing: kaç saatlik zirve kırılsın (72 = 3 gün; swing_pullback'te geri çekilmenin başladığı zirve penceresi)
SWING_LOOKBACK_HOURS=72
# swing: kırılım mumunun hacmi son 24 saatin ortalamasının en az kaç katı olsun
SWING_VOLUME_RATIO=1.5
# swing_pullback: zirveden geri çekilme en az / en fazla yüzde kaç olsun
SWING_PULLBACK_MIN_PCT=4
SWING_PULLBACK_MAX_PCT=12
# rotation: aynı anda kaç coin tutulsun (bakiye yetmezse otomatik azalır; MAX_OPEN_POSITIONS'tan fazla olamaz)
ROTATION_TOP_N=3
# rotation: momentum için son kaç günün getirisine bakılsın
ROTATION_LOOKBACK_DAYS=28
# rotation: kaç günde bir yeniden dengelensin (UTC 00:05'ten sonra, günlük mum kapanınca)
ROTATION_DAYS=7
# rotation: BTC bu günlük ortalamanın altına inince her şey satılıp USDT'de beklenir (0 = filtre kapalı)
ROTATION_BTC_MA_DAYS=50
# rotation: sıralamaya girecek en hacimli coin sayısı
ROTATION_UNIVERSE=30
# rotation: yalnızca bu coinler (boş = en hacimli ROTATION_UNIVERSE coin). Büyük coin trendi için:
#   ROTATION_COINS=BTC      + ROTATION_TOP_N=1 → BTC'yi trend varken tutar, yokken USDT'de bekler
#   ROTATION_COINS=BTC,ETH  + ROTATION_TOP_N=1 → ikisinden güçlü olanı (2 → ikisini birden)
# Küçük sermayede BTC / ETH ancak komisyon BNB'den ödenirse alınabilir (aşağıda BNB_FEES).
ROTATION_COINS=
# mean_revert: kapanış 20 saatlik ortalamanın kaç standart sapma altında olmalı (büyüdükçe daha az ama daha derin düşüş)
MR_BAND_STD=2
# mean_revert: yalnızca en hacimli bu kadar coin (büyük, likit coinler)
MR_UNIVERSE=20
# intraday: hangi coinler (virgülle; boş = en hacimli INTRADAY_UNIVERSE coin). Varsayılan: Kasım 2023'ün piyasa
# değeri en büyük 10 coini (stabil coinler ve BNB hariç; BNB komisyon için tutulur). Güncel ilk 10'a göre düzenleyin.
INTRADAY_COINS=BTC,ETH,XRP,SOL,ADA,DOGE,TRX,LINK,DOT,LTC
INTRADAY_UNIVERSE=10
# intraday: giriş taktiği (virgülle birden çoğu yazılabilir; yazılış sırasıyla ilk sinyal veren alınır):
#   vwap      = fiyat gün başından (UTC 00:00) beri oluşan VWAP'ın INTRADAY_BAND_STD standart sapma altına inip
#               yeşil mumla dönünce (ortalamaya dönüş)
#   bollinger = önceki mum Bollinger alt bandının (20 mum) altında kapanıp son mum bandın içine yeşil dönünce
#   rsi2      = 2 periyotluk RSI INTRADAY_RSI2_MAX'ın altına inince (kısa süreli aşırı satım)
#   orb       = gün başının ilk INTRADAY_ORB_MINUTES dakikasının zirvesi hacimle ilk kez kırılınca (açılış aralığı)
#   ema_cross = 5 dk EMA9, EMA21'i yukarı kesince (RSI 50-70)
#   squeeze   = Bollinger bantları son 10 saatin en darına yakınken üst bant hacimle kırılınca (sıkışma)
#   donchian  = son INTRADAY_BREAKOUT_BARS mumun zirvesi hacimle kırılınca
#   pullback  = yükselen trendde (EMA50 > EMA200) EMA20'ye geri çekilip önceki mumun zirvesi aşılınca
#   dip       = son 3 saatte ATR'nin en az 4 katı düşüş, RSI 30 altı, dönüş başlamışken
INTRADAY_TACTIC=vwap
# intraday: true = yalnızca 5 dk EMA50 > EMA200 ve fiyat EMA200 üstündeyken al (yükselen günde)
INTRADAY_TREND_FILTER=true
# intraday: vwap / bollinger / squeeze bandı (standart sapma), rsi2 eşiği, açılış aralığı (dk), donchian zirve
# penceresi (mum), kırılım hacmi (ortalamanın katı), en düşük 5 dk oynaklık (ATR %; daha durgunsa hedefe gidemez)
INTRADAY_BAND_STD=2
INTRADAY_RSI2_MAX=10
INTRADAY_ORB_MINUTES=60
INTRADAY_BREAKOUT_BARS=48
INTRADAY_VOLUME_RATIO=1.5
INTRADAY_MIN_ATR_PCT=0.1
# ----- Vadeli işlem (STRATEGY=futures; Binance USDⓈ-M) -----
# Gerekenler: Binance'te USDT'yi Spot'tan "USDⓈ-M Vadeli" cüzdanına aktarın; API anahtarında "Enable Futures" izni
# açık olsun. Hesap tek yönlü (One-Way) modda olmalı (Hedge modundaysa ve açık pozisyon yoksa bot kendisi alır).
# Hangi coinlerde (virgülle). Varsayılan: Kasım 2023'te piyasa değeri en büyük 10 coin (stabil coinler, TON, MATIC hariç)
FUTURES_COINS=BTC,ETH,BNB,XRP,SOL,ADA,DOGE,TRX,LINK,DOT
# Daha çok coin: FUTURES_UNIVERSE=N → "en hacimli N köklü coin" (en az FUTURES_UNIVERSE_MIN_AGE_DAYS gündür listelenen
# kripto pariteler, son FUTURES_UNIVERSE_AVG_DAYS günün ortalama USDT hacmine göre; günde bir yenilenir) taranır;
# FUTURES_UNIVERSE_WITH_LIST=true ise yukarıdaki FUTURES_COINS de eklenir (liste ∪ köklü N). 0 = yalnızca FUTURES_COINS.
# İşlem sayısı araştırması (Kasım 2026, 1 dk çıkışlar): liste + köklü 20 + kârdan sonra beklemesiz (SYMBOL_COOLDOWN 0,
# zarar sonrası 240 dk, zarar serisi molası yok): yılda 137 işlem, +%99/yıl (2023-11 → 2026-10); yalnızca liste:
# 53 işlem, +%62/yıl. 2020-2023'te de 242 / 161 işlem, +%379 / +%123. Köklü 30 ve üstü doğrulamada bozuldu.
# Bekleme / seri ayarları için: Telegram → ⚙️ Ayarlar → ⭐ Önerilen ayarlar (spot stratejileri etkilenmez).
FUTURES_UNIVERSE=20
FUTURES_UNIVERSE_WITH_LIST=true
FUTURES_UNIVERSE_MIN_AGE_DAYS=1095
FUTURES_UNIVERSE_AVG_DAYS=180
# Hacim sıralaması: avg = son FUTURES_UNIVERSE_AVG_DAYS günün ortalama hacmi (önerilen) | daily = bir önceki UTC gününün
# hacmi, her gün 00:00 UTC'de yenilenir ("son 24 saatte en çok hacim yapan N coin"; yaş için yukarıdaki MIN_AGE_DAYS,
# en az 30). Faz 4 testinde günlük en hacimli 30, ≥3 yıllık coinlerle bile 2024-2026'da her yıl -%66 ile -%91 arası
# zarar etti; yaş filtresiz 7 yılda 627 farklı (çoğu hype) coin giriyor (README).
FUTURES_UNIVERSE_MODE=avg
# Giriş taktiği: crash = çöküş dönüşü (2020-2026 testinde kârlı) | liq4 = 4'lü onay (zarar etti)
FUTURES_TACTIC=crash
# crash: son FUTURES_CRASH_HOURS saatte en az FUTURES_CRASH_DROP_PCT düşüş; FUTURES_CRASH_LIQ=true ise o mumda
# likidasyon dalgası da şart (testte daha az işlem, daha yüksek kazanma oranı: %78)
FUTURES_CRASH_HOURS=4
FUTURES_CRASH_DROP_PCT=10
FUTURES_CRASH_LIQ=false
# Dinamik çöküş (hepsi varsayılan kapalı; yukarıdaki ana kural aynen geçerli, bunlar ona eklenir):
# FUTURES_CRASH_EXTRA: ana kurala VEYA ile eklenen pencereler "saat:%" (ör. 1:6,12:15 = son 1 saatte %6 ya da son
#   12 saatte %15 düşüş de yeter; mikro / standart / makro çöküş). Boş = yalnızca ana kural.
# FUTURES_CRASH_Z > 0: sabit yüzdeler yerine oynaklık eşiği: düşüş, coinin o süredeki olağan hareketinin (önceki 24
#   saatin 5 dk getirilerinin standart sapması × √mum sayısı) en az Z katı olmalı ("son 4 saatte 3 standart sapma");
#   yine de en az FUTURES_CRASH_Z_MIN_PCT (%) düşüş aranır. 0 = kapalı.
# FUTURES_CONFIRM (izleme modu): close = çöküş mumunun kapanışında hemen al | volume = çöküşten sonraki
#   FUTURES_CONFIRM_BARS mum (12 × 5 dk = 1 saat) içinde hacmi önceki 20 mumun FUTURES_CONFIRM_VOLUME_RATIO katı olan
#   mumda (kapitülasyon) | green = aynı süre içinde ilk yeşil mumda | either = hangisi önce gelirse.
# Izgara testi (python main.py --backtest --strateji futures --izgara; sonuçlar README'de): ek 1 saatlik pencere işlem
# sayısını artırdı; yeşil mum teyidi kârı düşürdü, hacim teyidi işlemi azalttı, σ eşiği sabit yüzdeden kötü çıktı.
# En iyi iki yapılandırma Telegram → 🧭 Giriş sinyali → 🏆 Izgara #1 / 🥈 Izgara #2 (önce test modunda deneyin).
# Kasım 2026 testi (rapor_13): 12 saatlik pencere (12:15) doğrulama döneminde kârı düşürdü (bulduğu işlemler işlem
# başı ~%0, tam boy ilk pozisyonu kapatıyor): Faz 6 setinde (3x) yıllık +%352 yerine +%209, tek pozisyonda +%213 yerine +%146.
# Önerilen: 1:6 (🥈 #2 girişi).
FUTURES_CRASH_EXTRA=
FUTURES_CRASH_Z=0
FUTURES_CRASH_Z_MIN_PCT=3
FUTURES_CONFIRM=close
FUTURES_CONFIRM_BARS=12
FUTURES_CONFIRM_VOLUME_RATIO=3
# Ek giriş modülleri (Faz 3; hepsi varsayılan kapalı, çöküş kuralına VEYA ile eklenir; tek pozisyon, aynı anda
# sinyallerde öncelik çöküş > pompa > kırılım > Bollinger). Telegram → 🧭 Giriş sinyali → 🧩 Ek modüller.
# FUTURES_PUMP_RULES: pompa dönüşü SHORT, "saat:%" YÜKSELİŞ (ör. 1:6,4:10,12:15); boş = kapalı
# FUTURES_BB: Bollinger (20 mum, FUTURES_BB_STD σ) + RSI(14): off | both | long | short. Long: kapanış alt bandın
#   altında ve RSI < FUTURES_BB_RSI_LOW; short: üst bandın üstünde ve RSI > FUTURES_BB_RSI_HIGH
# FUTURES_BREAKOUT=true: hacimli kırılım LONG: hacim önceki 20 mumun FUTURES_BREAKOUT_VOLUME_RATIO katından fazla ve
#   kapanış son FUTURES_BREAKOUT_HOURS saatin zirvesinin üstünde
# Faz 3 testi (python main.py --backtest --strateji futures --modul-izgara; sonuçlar README'de): üç modül de 2020-2026
# testinde zarar etti (pompa short yılda ~740 işlem, işlem başı -%0.11; çöküşle birlikte ~1.000 işlem ama hesap eridi;
# Bollinger / kırılım işlem başı -%0.1); hepsi birlikte yılda 5.000+ işlem, 2025'te -%91. Yalnızca test modunda deneyin.
FUTURES_PUMP_RULES=
FUTURES_BB=off
FUTURES_BB_STD=2
FUTURES_BB_RSI_LOW=25
FUTURES_BB_RSI_HIGH=75
FUTURES_BREAKOUT=false
FUTURES_BREAKOUT_VOLUME_RATIO=3
FUTURES_BREAKOUT_HOURS=4
# Faz 4 (Kasım 2026; varsayılan kapalı, yalnızca LONG; test: python main.py --backtest --strateji futures --faz4-izgara):
# FUTURES_FUNDING=true: fonlama sıkışması: son ödenen fonlama oranı (8 saate oranlanmış; 4 / 1 saatte bir ödenende ×2 /
#   ×8) FUTURES_FUNDING_RATE_PCT veya altında (-0.10 = short'lar 8 saatte %0.10 ödüyor) VE FUTURES_FUNDING_RULES
#   çöküşlerinden biri ("saat:%"; 1:5 = son 1 saatte %5)
# FUTURES_PULLBACK=true: trend içi düzeltme: son tamamlanan 1 saatlik kapanış 1 saatlik EMA(FUTURES_PULLBACK_EMA)
#   üstünde ve 5 dk RSI(14) < FUTURES_PULLBACK_RSI
# Testte fonlama çöküş kuralına yılda yalnızca ~4 işlem ekledi (sonuç aynı); düzeltme yılda ~1.240 işlem ama işlem başı
# -%0.01, 2022-2026 her yıl zarar. Yalnızca test modunda deneyin.
FUTURES_FUNDING=false
FUTURES_FUNDING_RATE_PCT=-0.10
FUTURES_FUNDING_RULES=1:5
FUTURES_PULLBACK=false
FUTURES_PULLBACK_RSI=25
FUTURES_PULLBACK_EMA=200
# Kaldıraç (1-20; Telegram → ⚙️ Ayarlar'dan anlık değişir). Her girişten HEMEN önce Binance'te ISOLATED + bu kaldıraç
# ayarlanır. Zarar kes likidasyondan (10x ≈ %9.5, 20x ≈ %4.5 fiyat hareketi) en az 0.5 puan önce olmalı.
# crash taktiğinde önerilen 2x (en fazla 3x): zarar kes %4 → 2x'te teminatın ~%8'i, 10x'te ~%40'ı.
FUTURES_LEVERAGE=2
# Serbest bakiyenin teminat olarak kullanılan yüzdesi (bileşik: her işlem güncel bakiyenin tamamıyla; kalan %5
# komisyon payı içindir — %100 yazılırsa Binance "Margin is insufficient" verebilir, bot o zaman %10 küçültür)
FUTURES_MARGIN_USAGE_PCT=95
# liq4 taktiği (4'lü onay): hacim (mum hacmi önceki 20 mumun ortalamasının en az katı), likidasyon vekili (zorla satış / alış hacmi
# önceki 20 mumun ortalamasının en az katı + son 1 saatin dibi / zirvesi kırıldı + ≥1 ATR itiş), RSI uyumsuzluğu
# (önceki dipte RSI ≤ FUTURES_DIV_OVERSOLD, yeni dipte en az FUTURES_DIV_RISE puan yüksek), BTC 1 saatlik trendi
FUTURES_VOLUME_RATIO=2.5
FUTURES_LIQ_RATIO=3
FUTURES_DIV_OVERSOLD=40
FUTURES_DIV_RISE=3
FUTURES_BTC_TREND=true
# Likidasyon ölçümü: proxy = mumlardan (backtest ile birebir aynı) | feed = Binance'in anlık likidasyon akışı (son 5 dk'da
# en az FUTURES_LIQ_MIN_USDT) | both = ikisi birden. feed / both geçmiş verisi olmadığı için backtest edilemez.
FUTURES_LIQ_SOURCE=proxy
FUTURES_LIQ_MIN_USDT=100000
# Yön: both | long | short
FUTURES_SIDES=both
# Kâr Al emri: limit (Binance'te bekleyen reduceOnly limit, maker komisyon %0.02) | market (TAKE_PROFIT_MARKET)
FUTURES_TP_ORDER=limit
# Giriş emri: market = piyasa emri (taker %0.05 + kayma) | limit = bid'in FUTURES_LIMIT_OFFSET_PCT (%) altına post-only
# limit emir (maker %0.02, kayma yok), FUTURES_LIMIT_TTL_MIN dakikada dolmazsa iptal (bot kapanırken de iptal edilir).
# Faz 4 testinde limit maliyeti işlem başı ~%0.05 düşürdü ama emirlerin ~%11'i dolmadı ve kaçanlar en hızlı toparlanan
# işlemlerdi (ort. +%1.06): işlem başı +%0.31 → +%0.23; kayma 3 katına çıksa da piyasa emri önde. Önerilen: market.
FUTURES_ENTRY_ORDER=market
FUTURES_LIMIT_OFFSET_PCT=0.05
FUTURES_LIMIT_TTL_MIN=3
# Hızlı giriş (Kasım 2026; varsayılan kapalı; Telegram → 🎯 Çıkışlar ve Emirler → ⚡ Hızlı giriş). Saniyelik veride çöküş
# mumunun kapanışından sonra fiyat ortalama 1 sn'de %0.015, 3 sn'de %0.04, 5 sn'de %0.05, 10 sn'de %0.08 yükseliyor;
# backtest kapalıyken 5 sn (%0.05), açıkken ~2.5 sn (%0.04) varsayar. true: tarama mum kapanışından 3 yerine 1 sn sonra başlar (her coinin yanıtında yeni mum
# da görünmeli; görünmeyen coin 0.25 sn arayla yeniden istenir, en geç eski tarama anında eskisi gibi devam edilir;
# ölçümde mumlar ~2-2.5 sn'de kesinleşiyor), mumlar tek dalgada paralel istenir, teminat modu
# (ISOLATED) ve kaldıraç TARANAN TÜM COİNLERDE önceden ayarlanıp her taramadan hemen önce Binance'ten doğrulanır
# (doğrulanamayan coinde eskisi gibi girişten hemen önce ayarlanır). Sinyal kuralları, pozisyon boyları ve çıkışlar
# DEĞİŞMEZ. Giriş gecikmesi bu ayardan bağımsız her zaman ölçülür: pozisyon açılış mesajında, /tarama'da ve backtest
# raporunun "CANLI BOT KARŞILAŞTIRMASI" bölümünde görünür. Öneri: önce kapalıyken birkaç gün ölçün, sonra açıp karşılaştırın.
FUTURES_FAST_ENTRY=false
# Her dakika tarama (Kasım 2026, rapor 19 araştırması; varsayılan kapalı; Telegram → 🎯 Çıkışlar ve Emirler → ⏱️ Her dakika
# tara). Bot çöküş kuralını yalnızca 5 dk mum kapanışlarında değerlendirir; 5 dk'dan kısa süren dipleri görmez ve bir
# pozisyon kapandıktan sonra yenisi için sıradaki 5 dk kapanışını bekler. true: kural her dakika değerlendirilir. Ara
# dakikalarda coinin 1 dk mumlarından "o dakikada kapanan" 5 dk mumlar üretilir ve AYNI kural / eşikler uygulanır (canlı
# bot ve backtest ortak fonksiyon); 5 dk kapanışlarında hiçbir şey değişmez. Test (2020-2026, Faz 9 seti, 10 çekilişin
# ortancası; seçim / doğrulama): yılda 929 → 1.662 işlem, bileşiksiz yıllık getiri +%391 / +%235 → +%536 / +%278, bileşik
# +%939 / +%409 → +%1.954 / +%423, işlem başı net aynı (+%0.15). Zayıf yanları: doğrulamada en büyük düşüş %68 → %77,
# 3 kat kaymada doğrulama getirisi +%144 → +%56 (işlem çok, maliyete daha duyarlı), 2022 ve 2024'te geride, son 12 ay
# +%147 → +%112. Yalnızca sade çöküş taktiğinde (ek modül, likidasyon şartı, oynaklık eşiği, onay modu kapalı) ve piyasa
# emriyle girişte çalışır; değilse 5 dk'da bir taranır. Canlıda dakikada bir, coin başına 485 adet 1 dk mum istenir
# (istek ağırlığı 5 dk taramayla aynı). Backtest ilk çalıştırmada evrenin 1 dk mumlarını indirir (~2 GB disk, ~2 GB RAM)
# ve birkaç kat uzun sürer. Önce test modunda deneyin.
FUTURES_MINUTE_SCAN=false
# Anlık tarama (Kasım 2026, rapor 20 araştırmasının ikinci turu; varsayılan kapalı; Telegram → 🎯 Çıkışlar ve Emirler →
# 🚀 Anlık tarama). Yalnızca FUTURES_FAST_ENTRY=true iken, sade çöküş taktiğinde ve piyasa emriyle girişte çalışır.
# Binance az önce kapanan mumu 0.3-2.5 sn sonra kesinleştirir; toplu fiyat ucu ise gecikmesizdir. true: geçmiş mumlar
# kapanıştan ~2 sn önce alınır, kapanıştan ~0.15 sn sonra tek istekle son işlem fiyatları okunur ve az önce kapanan mumun
# kapanışı olarak o fiyat kullanılır; emir bakiye / emir defteri isteği beklemeden gider (bakiye kapanıştan önce okunur);
# açık pozisyon varken tarama pozisyon kontrolünü beklemez (kontrol taramadan hemen sonra yapılır). Kural, eşikler,
# pozisyon boyları ve çıkışlar DEĞİŞMEZ. Değeri (backtest, dakikalık tarama + dalga eşikleri kapalı, 3 çekiliş): giriş
# payı %0.05 → %0.02 olunca bileşiksiz yıllık getiri +%558 / +%305 → +%598 / +%345, bileşik +%2.126 / +%687 → +%2.237 /
# +%1.070, 3 kat kaymada +%645 / +%173 → +%1.474 / +%382, işlem sayısı +%1-2. Bot her anlık taramayı sonradan
# kesinleşen mumlarla kendisi doğrular (rapor: "Anlık tarama doğrulaması"); fiyat alınamazsa, veri bayatsa ya da tarama
# geciktiyse o tarama olağan hızlı yoldan yapılır, doğrulama bozuk veri gösterirse anlık tarama 1 saat kullanılmaz.
# Gerçek vadeli API'ye karşı yalnızca sunucunuzda çalışır (burada sahte borsa ve spot veri ucuyla sınandı): açtıktan
# sonraki ilk raporda "Anlık tarama doğrulaması" ve "Giriş gecikmesi" satırlarına bakın. Önce test modunda deneyin.
# İlk canlı ölçüm (rapor 22, gerçek hesap, 852 tarama): sinyaller mum kapanışından 0.42 sn sonra hazır (hızlı girişte 2.0
# sn); 850 taramanın 850'si kesinleşmiş mumlarla aynı sonucu verdi. İlk 3 gerçek girişte dolum 0.6 sn'de, kapanış
# fiyatına göre %0.000 / +%0.111 / −%0.043: backtest bu ayar açıkken giriş gecikmesi payını %0.02 alır (raporda "Eski
# giriş varsayımıyla" satırı eski %0.05'le kıyaslar). Geçmiş mumlar bellekte tutulur: her dakika coin başına son 6 mum.
FUTURES_SNAPSHOT_SCAN=false
# Dalga modu (Faz 5, varsayılan kapalı; Telegram → 🧭 Giriş sinyali → 🌊 Dalga modu). "Genişlik" = taranan coinlerden
# son 1 saatte en az %3 düşenlerin sayısı. FUTURES_MAX_POSITIONS=N: aynı anda en fazla N pozisyon, her biri bakiyenin
# FUTURES_MARGIN_USAGE_PCT / N'i teminat; 2. ve sonraki pozisyon yalnızca genişlik ≥ FUTURES_EXTRA_BREADTH iken.
# FUTURES_ISOLATED_SIZE_PCT: genişlik FUTURES_ISOLATED_BREADTH'in altındayken (yalnız çöküş) pozisyon büyüklüğü (%).
# DÜZELTİLMİŞ test (Kasım 2026: giriş gecikmesi ve mum içi başabaş payıyla, bkz. README "Saniyelik veri"; 2020-2026,
# #2 ayarlarıyla): 2 pozisyon, 3x, ≥8 coin → yılda ~445 işlem (341 yerine), işlem başı +%0.21, yıllık getiri +%177 /
# +%90 (#2 tek pozisyon 2x: +%193 / +%90), en büyük düşüş %76 / %52 (%72 / %60 yerine); zarar kes emirleri büyük
# fitillerde kötü dolarsa ikisinde de hesap eridi. Yalnızca FUTURES_ISOLATED_SIZE_PCT=50 (#2'de): işlem sayısı aynı,
# +%228 / +%103, doğrulama dönemi düşüşü %60 → %46. Önce test modunda (paper) deneyin.
# (Kasım 2026 öncesi buradaki ve README'nin eski bölümlerindeki rakamlar 2-4 kat iyimserdi.)
FUTURES_MAX_POSITIONS=1
FUTURES_EXTRA_BREADTH=8
FUTURES_ISOLATED_SIZE_PCT=100
FUTURES_ISOLATED_BREADTH=2
# Durulmuş çöküş (rapor 14 araştırması, varsayılan kapalı; Telegram → 🌊 Dalga modu → ⏱️ Durulmuş çöküş):
# FUTURES_RECENT_SIZE_PCT: girişten önceki 15 dk'da fiyat FUTURES_RECENT_DROP_PCT'den (%) az düştüyse (çöküş durulmuş)
# pozisyon bu büyüklükte (%; 100 = kapalı, eskisi gibi). Hâlâ sert düşen coinde tam boy; yalnız çöküş ve düşüşte
# küçültme çarpanlarıyla çarpılır. Ölçü 5 dk mumların kapanışından (dakikalık taramada o dakikada kapanan 5 dk mumlar),
# canlı bot ve backtest aynı fonksiyonla. Gerçekçi modelde (2020-2026, 4.000 USDT, 5x, rapor 14 ayarı, 10 çekiliş)
# son 15 dk'da %2.4'ten az düşerken açılan işlemler her yıl işlem başı ~%0 getirdi. %2.4 ve %50 / %33 ile 71 hesabın
# 12 ay ortancası +%709 → +%794 / +%816, %60'ı aşan düşüş yaşayan hesap 14 → 4 / 5, A'nın en büyük düşüşü %57 → %46 /
# %43. Açılan düşüş payıyla: %33 + FUTURES_LEVERAGE=6 + FUTURES_DD_SCALE_PCT=30 + FUTURES_DD_SCALE_SIZE_PCT=60 →
# +%927, %60'ı aşan düşüş 8, A düşüşü %45. Ayrıntı: README "Rapor 14 araştırması". Önce test modunda deneyin.
FUTURES_RECENT_SIZE_PCT=100
FUTURES_RECENT_DROP_PCT=2.4
# Vadeli-spot farkı (rapor 17 araştırması, 22 Kasım; varsayılan kapalı; Telegram → 🌊 Dalga modu → ⚖️ Vadeli-spot farkı):
# FUTURES_BASIS_SIZE_PCT: girişte vadeli fiyat spotun FUTURES_BASIS_DEEP_PCT (%) değerinden fazla altındaysa (likidasyon
# zincirinde zorla satış izi) pozisyon bu büyüklükte (%; 100 = kapalı, eskisi gibi; boştaki teminatla sınırlı, tek
# pozisyon modunda etkisiz). Canlıda spot fiyatı vadeli fiyatla aynı anda Binance spot ucundan alınır; backtest spot
# 1 dk arşivini kullanır (ilk çalıştırmada indirilir). 2020-2026'da fark −%0.5'ten derinken açılan işlemler her yıl
# ortalamanın çok üstündeydi (işlem başı +%0.89 / +%1.59, tümü +%0.25). %0.5 / %130 ile (6x, 10 çekiliş) 4.000 USDT'de
# 71 hesabın 12 ay ortancası +%940 → +%1.034, %60'ı aşan düşüş aynı (8); 24 USDT'de +%1.345 → +%1.480, %60'ı aşan
# düşüş 20 → 25. %150 daha kârlı ama daha riskli (4.000 USDT'de +%1.149 / düşüş 12; 24 USDT'de önerilmez).
# Ayrıntı: README "Rapor 17 araştırması, üçüncü tur". Önce test modunda deneyin.
FUTURES_BASIS_SIZE_PCT=100
FUTURES_BASIS_DEEP_PCT=0.5
# Sinyal kalitesi (rapor 18 araştırması, 22 Kasım; varsayılan kapalı; Telegram → 🌊 Dalga modu → 🧮 Kalite puanı):
# FUTURES_QUALITY_SIZE_PCT: yedi ölçülü birleşik puan (çöküş şiddeti, vadeli-spot farkı, son 15 dk piyasa alış payı, son
# 5 / 15 dk düşüş, hacim ve satış hacmi oranı; her biri 2020-2023 sinyallerine göre yüzdelik sıra) sinyallerin en zayıf
# FUTURES_QUALITY_CUT_PCT yüzdesindeyse (40 ya da 60) pozisyon bu büyüklükte (%; 100 = kapalı, eskisi gibi). Puan açıkken
# spot fiyatı da alınır (vadeli-spot farkı puanın ölçüsü). 2020-2026'da en zayıf %60'taki işlemler ortalamada ~%0
# (2023-2026'da eksi), en güçlü %20 her yıl +%0.37 … +%0.54. %60 / %60 ile (6x, 10 çekiliş) 4.000 USDT'de 71 hesabın 12
# ay ortancası +%1.034 → +%1.097, %60'ı aşan düşüş 8 → 7; 24 USDT'de +%1.480 → +%1.554, düşüş aynı (25). Ayrıntı:
# README "Rapor 18 araştırması, üçüncü tur". Önce test modunda deneyin.
FUTURES_QUALITY_SIZE_PCT=100
FUTURES_QUALITY_CUT_PCT=60
# Büyük hesap kuralları (rapor 19 araştırması, 23 Kasım; varsayılan kapalı; Telegram → 🌊 Dalga modu → 🏦 Büyük hesap):
# FUTURES_BIG_ACCOUNT_USDT: gerçekleşen bakiye (başlangıç + gerçekleşen K/Z) bu tutarı aşınca iki kural devreye girer:
# kalite puanı en güçlü %20'lik sinyaller FUTURES_MAX_POSITIONS'a ek 2 pozisyon açabilir; zayıf sinyale (puan en zayıf
# %60'ta) son ödenen fonlama oranı ≤ 0 ise girilmez (açıklar kalabalık, düşüş trendi). Büyük hesapta pozisyonlar emir
# defteri derinliğiyle sınırlanır ve teminatın bir kısmı boşta kalır; ek yuvalar onu kullanır. Küçük hesapta iki kural
# da zararlı (24 USDT'de 12 ay ortancası +%1.554 → +%1.405 / +%1.285), bu yüzden eşikle açılır. 5.000 ile (6x, 10
# çekiliş) 4.000 USDT'de 71 hesabın 12 ay ortancası +%1.097 → +%1.423, %60'ı aşan düşüş 7 → 8, kill-switch 0; 24
# USDT'de ilk yıl değişmez, hesap büyüyünce yıllık getiri artar. 0 = kapalı. Ayrıntı: README "Rapor 19 araştırması".
FUTURES_BIG_ACCOUNT_USDT=0
# En küçük emre yuvarlama (rapor 20 araştırması, 23 Kasım; varsayılan kapalı; Telegram → 🌊 Dalga modu → 🔼):
# FUTURES_QUALITY_ROUNDUP=true: kalite puanı en güçlü %40'taki sinyal Binance'in en küçük emir tutarının (çoğu coinde 5,
# ETH'de 20, BTC'de 100 USDT) altında kalırsa boşta teminat yetiyorsa o tutarla (+%5 pay) açılır; zayıf sinyaller eskisi
# gibi pas geçilir. Küçük hesap içindir: 24 USDT'de (6x, 10 çekiliş) 71 hesabın 12 ay ortancası +%1.554 → +%1.653,
# %60'ı aşan düşüş aynı (20), kill-switch 6 → 5; 4.000 USDT'de etkisiz. Herkese yuvarlamak (kalite ayrımı olmadan) önceki
# araştırmada sonucu biraz kötüleştirmişti. Ayrıntı: README "Rapor 20 araştırması".
FUTURES_QUALITY_ROUNDUP=false
# Faz 6 (hepsi varsayılan kapalı, Faz 5 ayarları değişmez; Telegram → 🌊 Dalga modu → ⭐ Faz 6 seti / Faz 6 tek pozisyon):
# FUTURES_REENTRY_BREADTH: son 1 saatte en az bu kadar coin %3+ düşerken zarar sonrası bekleme (LOSS_COOLDOWN_MINUTES)
#   uygulanmaz: dalgada zarar kesen coine yeniden girilebilir (0 = kapalı, önerilen 3). Yalnız çöküşte bekleme sürer.
# FUTURES_WAVE_RULES + FUTURES_WAVE_BREADTH: en az FUTURES_WAVE_BREADTH coin düşerken ek çöküş pencereleri ("saat:%";
#   1:5,4:8 = 1 saatte %5 veya 4 saatte %8 düşüş de sinyal; boş = kapalı)
# FUTURES_EXTRA_SIZE_PCT: dalga modunda ek pozisyonların büyüklüğü, ilk pozisyonun %'si (100 = eşit, Faz 5 gibi).
# DÜZELTİLMİŞ test (Kasım 2026; 2020-2026, #2 ayarlarıyla, 1 dk): Faz 6 seti (4 pozisyon, 3x, ek %16.7, yeniden giriş
# ≥3, 1:5,4:8 ≥12, yalnız çöküş %50) → yılda ~780 işlem (#2: 341), işlem başı +%0.22, yıllık getiri +%270 / +%166 (#2:
# +%193 / +%90), en büyük düşüş %66 / %45 (#2: %72 / %60); 2x'te +%167 / +%103, düşüş %48 / %31; 5x'te +%412 / +%279,
# düşüş %87 / %66. Faz 6 tek pozisyon (2x) → yılda ~390 işlem, +%379 / +%159, düşüş %59 / %45.
# Önce test modunda (paper) deneyin; ayrıntı README (Faz 6 ve "Saniyelik veri").
FUTURES_REENTRY_BREADTH=0
FUTURES_WAVE_RULES=
FUTURES_WAVE_BREADTH=12
FUTURES_EXTRA_SIZE_PCT=100
# Faz 8 (Kasım 2026, rapor 14; varsayılan kapalı; Telegram → 🧭 Giriş sinyali → 🌊 Dalga modu → 🔒 ek başabaş):
# FUTURES_EXTRA_BE_TRIGGER_PCT: dalga modunda EK pozisyonların (başka pozisyon açıkken açılanlar) başabaş tetiği (fiyat
#   %); 0 = BREAKEVEN_TRIGGER_PCT ile aynı. Taban (BREAKEVEN_FLOOR_PCT) ortaktır; ilk pozisyona dokunulmaz. Dalgada ek
#   yuvalar hep dolu olduğundan (sinyallerin çoğu yer olmadığı için atlanır) ek pozisyon kârını erken kilitleyip
#   kapanınca yuvası yeni bir sinyale geçer.
# DÜZELTME (rapor 15): ilk testteki kâr artışı backtestin iyimserliğiydi (1 dk mum, dar aralıkta fiyatın tabana geri
# dönüşünü görmüyordu). Saniyelik veriyle düzeltilmiş testte (Faz 6 seti + 0.5): yılda ~780 → ~925 işlem, işlem başı
# +%0.22 → +%0.15, yıllık getiri aynı (+%270 / +%166 → +%246 / +%168), en büyük düşüş %66 / %45 → %67 / %53, 3 kat
# kaymada +%142 / +%92 → +%82 / +%53. İşlem sayısı artar, kâr artmaz, maliyete dayanıklılık azalır.
